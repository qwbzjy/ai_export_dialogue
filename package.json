{
  "name": "ai-chat-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Export AI chat conversations (DeepSeek, Kimi, Doubao, Yuanbao, Qwen, Qianwen) to Markdown",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node test/run.mjs",
    "verify": "node build.mjs && node scripts/verify-render.mjs",
    "shots": "node scripts/make-store-screenshots.mjs && node scripts/compose-store-screenshots.mjs"
  },
  "dependencies": {
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1"
  }
}
